{
  "$comment": "VL_VoiceChanger 共通設定。vcClient.root は各自の環境に合わせて書き換える（Phase 0 で確定）。",
  "vcClient": {
    "root": "C:/Tools/vcclient_win_cuda",
    "launcher": "start_http.bat",
    "port": 18888,
    "startupTimeoutSeconds": 180
  },
  "paths": {
    "profiles": "config/profiles",
    "models": "models",
    "reports": "reports",
    "logs": "logs"
  },
  "stabilityTest": {
    "durationMinutes": 10,
    "sampleSeconds": 5,
    "processName": "MMVC_Client*,MMVCServerSIO*,vcclient*"
  }
}
